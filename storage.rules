rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read access to all assets (photos, logo, partners, media)
      allow read: if true;
      
      // Allow write access only to authenticated administrators
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
