rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ──────────────────────────────────────────────

    // Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user has the admin custom claim
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // ─── Site Content (single documents) ───────────────────────────────
    // Documents: hero, aboutTIG, aboutAIC, settings, back2bengal, workspace, apply
    // Public read (static site fetches this), admin-only write

    match /siteContent/{document} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Board Members ──────────────────────────────────────────────────
    // Public read (displayed on static site), admin-only write

    match /boardMembers/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Mentors ────────────────────────────────────────────────────────
    // Public read (displayed on static site), admin-only write

    match /mentors/{mentorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Pages ─────────────────────────────────────────────────────────
    // Public read (dynamic template site fetches this), admin-only write

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Careers ───────────────────────────────────────────────────────
    // Public read, admin-only write

    match /careers/{careerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Partners ──────────────────────────────────────────────────────
    // Public read, admin-only write

    match /partners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Featured Partners ─────────────────────────────────────────────
    // Public read, admin-only write

    match /featuredPartners/{partnerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Media ─────────────────────────────────────────────────────────
    // Public read (images referenced on static site), admin-only write

    match /media/{fileId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Gallery ───────────────────────────────────────────────────────
    // Public read, admin-only write

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── News Articles ─────────────────────────────────────────────────
    // Public read, admin-only write

    match /newsArticles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Startup Portal ─────────────────────────────────────────────────
    // Website pages startup-login.html / startup-dashboard.html; managed from
    // Dashboard → Startup Portal. A "startup" is a signed-in, email-verified user
    // whose email has a startups/{email} doc that isn't switched off.

    function isStartup() {
      return isAuthenticated()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/startups/$(request.auth.token.email))
        && get(/databases/$(database)/documents/startups/$(request.auth.token.email)).data.active != false;
    }

    match /startups/{email} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email == email);
      allow write: if isAdmin();
    }

    // Private: a startup can only read meetings addressed to its own email.
    match /meetings/{meetingId} {
      allow read: if isAdmin() || (isStartup() && resource.data.startupEmail == request.auth.token.email);
      allow write: if isAdmin();
    }

    match /portalEvents/{eventId} {
      allow read: if isAdmin() || isStartup();
      allow write: if isAdmin();
    }

    match /portalNotifications/{notificationId} {
      allow read: if isAdmin() || isStartup();
      allow write: if isAdmin();
    }

    // ─── Contact form submissions (website contact.html) ───────────────
    // Anyone can submit; only admins can read and change the status.

    match /contactSubmissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'phone', 'email', 'startup', 'stage', 'idea', 'source', 'campaign', 'page', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.idea is string && request.resource.data.idea.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if false;
    }

    // ─── Deny everything else ──────────────────────────────────────────
    // Any collection not explicitly listed above is denied by default
  }
}
